# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (Direct connection for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_ADMIN_EMAIL=your-email@gmail.com
SMTP_SENDER_NAME=Qr Platform

# App
APP_URL=http://localhost:9000
APP_ENV=development

# Invitation Security (dedicated HMAC key — do NOT reuse JWT secret)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Rotation policy: every 90 days, move current → _PREV, set new primary
# Only current + prev are checked (2-key window)
INVITE_HMAC_SECRET=your-dedicated-hmac-secret-64-hex-chars
INVITE_HMAC_SECRET_PREV=
HMAC_ROTATION_DAYS=90

# Worker (Celery + Redis) — production batch processing
# Set USE_WORKER=false for dev (falls back to BackgroundTask)
REDIS_URL=redis://localhost:6379/0
USE_WORKER=true

# Storage (Supabase Storage bucket for invitation assets)
# Create bucket 'invitations' in Supabase Dashboard > Storage
# Set to private, 500MB file size limit
STORAGE_BUCKET=invitations
SIGNED_URL_EXPIRY=3600
DOWNLOAD_URL_EXPIRY=604800
